  - "\u05DC\u05E2\u05DE \u05DD\u05DB\u05DC\u05E9 \u05D7\u05D3\u05E7\u05D0\u05D4 \u05EA\u05D0
    \u05DD\u05D9\u05D0\u05D5\u05E8 \u05DD\u05DC\u05D5\u05DB \u05D5\u05D9\u05E9\u05DB\u05E2
    :\u05DD\u05EA\u05D9\u05E8\u05D9\n!\u05E5\u05E4\u05D7\u05D4"
  - "\u0E22\u0E34\u0E07\u200B\u0E41\u0E25\u0E49\u0E27: \u0E15\u0E2D\u0E19\u0E19\u0E35\u0E49\u200B\u0E17\u0E38\u0E01\u0E04\u0E19\u200B\u0E40\u0E2B\u0E47\u0E19\u200B\u0E1B\u0E37\u0E19\u200B\u0E02\u0E2D\u0E07\u200B\u0E04\u0E38\u0E13\u200B\u0E40\u0E2B\u0E19\u0E37\u0E2D\u200B\u0E02\u0E2D\u0E07\u200B\u0E17\u0E35\u0E48\u200B\u0E04\u0E38\u0E13\u200B\u0E1B\u0E25\u0E2D\u0E21\u200B\u0E15\u0E31\u0E27!"
  - 'sina utala: jan ale li lukin e ilo utala sina lon sewi ijo sina!'
  - "\U000F195E\U000F1971\U000F199D\U000F1911\U000F1904\U000F1927\U000F192E\U000F1909\U000F190E\U000F1971\U000F195E\U000F192C\U000F195A\U000F190C\U000F195E!"
