  - "\uFE90\uFEF3\uFEAE\uFEA8\uFE98\uFEDF\uFE8D \uFEAA\uFEBF"
  - "\u05DD\u05D9\u05DC\u05D5\u05E8\u05D8 \u05D3\u05D2\u05E0"
