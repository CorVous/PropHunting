  - "\u30DE\u30C3\u30D7\u30B3\u30FC\u30C9\u3092\u5165\u529B\u3067\u304D\u308B\u306E\u306F\u30DB\u30B9\u30C8\u3060\u3051\u3067\u3059\u3002"
