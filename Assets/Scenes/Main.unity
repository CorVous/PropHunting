  - "\U000F195E\U000F1918\U000F1902\U000F1916\U000F190C\U000F1941."
  - No disguise changes left.
  - "\u5909\u8EAB\u306E\u6B8B\u308A\u56DE\u6570\u304C\u3042\u308A\u307E\u305B\u3093\u3002"
  - "\uBCC0\uC2E0 \uD69F\uC218\uAC00 \uB0A8\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - "\u53D8\u8EAB\u6B21\u6570\u5DF2\u7528\u5B8C\u3002"
